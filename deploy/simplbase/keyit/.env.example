KEYIT_RELAY_IMAGE=ghcr.io/simplbase/keyit-relay:latest
SIMPLBASE_PROXY_NETWORK=proxy

KEYIT_RELAY_MODE=production
KEYIT_RELAY_ROOT=/data/relay
KEYIT_RELAY_ADDR=0.0.0.0:8787
KEYIT_RELAY_PUBLIC_URL=https://relay.keyit.sh
KEYIT_RELAY_RATE_LIMIT_PER_MINUTE=120

KEYIT_RELAY_MAX_HEADER_BYTES=65536
KEYIT_RELAY_MAX_BODY_BYTES=2097152
KEYIT_RELAY_MAX_AUTHORIZATION_BYTES=524288
KEYIT_RELAY_MAX_REQUEST_PAYLOAD_BYTES=1572864
KEYIT_RELAY_MAX_REVISION_METADATA_BYTES=262144
KEYIT_RELAY_MAX_ENCRYPTED_PAYLOAD_BYTES=1048576
KEYIT_RELAY_MAX_REVISIONS_PER_ENVIRONMENT=10000

# Hosted account limits. 0 or unset disables a cap; a self-hosted relay
# is free to raise or disable any of these. See docs/relay-production.md.
KEYIT_RELAY_MAX_PROJECTS_PER_DEVICE=3
KEYIT_RELAY_MAX_ENVIRONMENTS_PER_PROJECT=3
KEYIT_RELAY_MAX_DEVICES_PER_PROJECT=5
KEYIT_RELAY_INACTIVE_RETENTION_DAYS=30
