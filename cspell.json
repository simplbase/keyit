{
  "version": "0.2",
  "language": "en",
  "useGitignore": true,
  "ignorePaths": [
    "target/**",
    "Cargo.lock"
  ],
  "patterns": [
    {
      "name": "keyitIdBody",
      "pattern": "\\b[a-z2-7]{52}\\b"
    },
    {
      "name": "keyitRecordId",
      "pattern": "\\bkv[depria]_[a-z2-7]+\\b"
    }
  ],
  "ignoreRegExpList": [
    "keyitIdBody",
    "keyitRecordId"
  ],
  "words": [
    "AAD",
    "AEAD",
    "AES",
    "Addrs",
    "buildx",
    "Caddy",
    "Caddyfile",
    "chrono",
    "ciphertext",
    "clippy",
    "Compose",
    "CSPRNG",
    "dalek",
    "DEKs",
    "deks",
    "depria",
    "differentprojectxyz",
    "dgst",
    "diffie",
    "dotenv",
    "encryptable",
    "formedness",
    "getrandom",
    "GCM",
    "GHCR",
    "healthcheck",
    "healthz",
    "hexdigit",
    "HEXLOWER",
    "HKDF",
    "impls",
    "injective",
    "inspectable",
    "IPFS",
    "Keyit",
    "keyit",
    "keypair",
    "keypairs",
    "Kiruthik",
    "materialize",
    "materialized",
    "materializes",
    "materialization",
    "msvc",
    "newtype",
    "newtypes",
    "NOPAD",
    "preimage",
    "preimages",
    "prerevision",
    "reparsed",
    "readyz",
    "rsplit",
    "roundtrips",
    "rustup",
    "serde",
    "semver",
    "Simplbase",
    "mktemp",
    "nologin",
    "unconstructed",
    "unhashed",
    "unquoted",
    "uppercased",
    "ureq",
    "X25519",
    "Zeroize",
    "zeroize",
    "zeroized",
    "zeroizes"
  ]
}
